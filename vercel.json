{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/ws", "dest": "/api/index.py" },
    { "src": "/check", "dest": "/api/index.py" },
    { "src": "/stats", "dest": "/api/index.py" },
    { "src": "/sessions", "dest": "/api/index.py" },
    { "src": "/sessions/(.*)", "dest": "/api/index.py" },
    { "src": "/proxies", "dest": "/api/index.py" },
    { "src": "/generate", "dest": "/api/index.py" },
    { "src": "/batch-generate", "dest": "/api/index.py" },
    { "src": "/networks", "dest": "/api/index.py" },
    { "src": "/health", "dest": "/api/index.py" }
  ]
}
